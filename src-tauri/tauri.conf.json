{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vpm-search",
  "version": "0.1.0",
  "identifier": "com.asonnychen.vpm-search",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vpm-search",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "license": "CC BY 4.0 (DB-IP Country Lite)",
    "licenseFile": "../THIRD_PARTY_NOTICES.md",
    "resources": {
      "resources/geoip/dbip-country-lite.mmdb": "geoip/dbip-country-lite.mmdb",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
